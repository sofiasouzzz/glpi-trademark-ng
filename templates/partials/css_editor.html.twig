<div class="card mt-4 border shadow-sm">
   <div class="card-header bg-body-tertiary d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
         <i class="ti ti-code fs-2 text-primary"></i>
         <span class="fw-bold">{{ labels.custom_css|format(editor.label) }}</span>
      </div>

      <div class="d-flex align-items-center gap-2">
         <label class="form-label m-0 small fw-semibold text-muted">{{ labels.css_type }}:</label>
         {{ editor.select_html|raw }}
      </div>
   </div>

   <div class="card-body p-0">
      <textarea id="{{ editor.textarea_id }}" name="{{ editor.field_name }}" class="form-control trademark-codemirror font-monospace">{{ editor.value }}</textarea>
   </div>
</div>

<script type="text/javascript">
   $(function() {
      var textarea = document.getElementById({{ editor.textarea_id|json_encode|raw }});
      if (textarea && typeof CodeMirror !== "undefined") {
         var editorCode = CodeMirror.fromTextArea(textarea, {
            mode: "text/x-scss",
            lineNumbers: true,
            viewportMargin: Infinity,
            extraKeys: {
               "Ctrl-Space": "autocomplete"
            },
            foldGutter: true,
            gutters: ["CodeMirror-linenumbers", "CodeMirror-foldgutter"]
         });
         $("#{{ editor.textarea_id }}").data("CodeMirrorInstance", editorCode);
         setTimeout(function () { editorCode.refresh(); }, {{ editor.refresh_wait }});
      }
   });
</script>
