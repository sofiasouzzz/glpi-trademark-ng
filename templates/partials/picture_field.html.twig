<div class="mb-3">
   <label class="form-label fw-bold d-flex align-items-center justify-content-between">
      <span>{{ picture.label }}</span>
      {% if picture.recommended_size %}
         <span class="badge bg-secondary-lt text-secondary font-monospace"><i class="ti ti-dimensions me-1"></i>{{ picture.recommended_label }}</span>
      {% endif %}
   </label>

   <div class="card p-3 bg-body-tertiary border">
      <div class="row align-items-center g-3">
         {% if picture.image_url %}
            <div class="col-auto">
               <div class="rounded border p-2 bg-body d-flex align-items-center justify-content-center shadow-sm" style="min-width: 110px; min-height: 75px; max-width: 180px;">
                  <img src="{{ picture.image_url }}" alt="{{ picture.label }}" class="img-fluid" style="max-width: 140px; max-height: 65px; object-fit: contain;">
               </div>
            </div>

            <div class="col-auto">
               <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" name="_blank_{{ picture.name }}" id="_blank_{{ picture.name }}" value="1">
                  <label class="form-check-label text-danger small fw-semibold" for="_blank_{{ picture.name }}">
                     <i class="ti ti-trash me-1"></i>{{ labels.reset }} ({{ labels.remove }})
                  </label>
               </div>
            </div>
         {% endif %}

         <div class="col-12">
            {{ picture.upload_html|raw }}
         </div>
      </div>
   </div>
</div>
